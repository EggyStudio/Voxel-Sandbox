<Project Sdk="Microsoft.NET.Sdk">

    <!-- A voxel game, built on the engine's package as any game is. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <RootNamespace>VoxelSandbox</RootNamespace>
    </PropertyGroup>

    <!-- The package carries the generator that registers the game's [Command]s, and the fixes an
         editor offers for its diagnostics, as analyzers. -->
    <ItemGroup>
        <PackageReference Include="3DEngine" Version="6.2.32" />
    </ItemGroup>

    <!-- The game's own shaders and packs.json, found beside the program under resources. Each
         names its place by its folders, since MSBuild takes a file reached through a link, as
         /home is to /var/home, as lying outside the project and copies it flat beside the program. -->
    <ItemGroup>
        <Content Include="resources\**\*" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
