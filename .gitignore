# .NET build output
# Unanchored, since every project directory has its own pair.
bin/
obj/

# Tests and build logs
TestResults/
*.trx
*.binlog
msbuild.log

# The Slang compiler build/fetch-slang.sh downloads into build/tools, the shaders build/shaders.sh
# compiles for a shipped build, and the native builds build/publish.sh makes.
/build/tools/
/build/shader-cache/
/build/publish/
# What build/play.sh captures and logs, kept as a run's artifact.
/captures/
# The engine as the build workflow checks it out, for its e3d.
/.engine/
# Every picture taken while working, each day's in a folder with its captions (N 4.10), kept on the
# machine that took them and never committed.
/.github/dump/

# Compiled Slang, written beside the program that ran a shader. A shipped build carries the cache
# the pack run fills, so a copy in git would go stale with every shader edit.
.slang-cache/

# Dear ImGui's own window layout file, written beside whatever ran it.
imgui.ini

# IDEs
.idea/
*.DotSettings.user
.vs/
*.user
*.suo
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Operating system
.DS_Store
Thumbs.db
desktop.ini
